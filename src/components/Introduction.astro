---
import bgMobile from "../assets/resources/Background_decor.svg?url";
---

<section class="relative md:col-span-3 xl:col-span-2">
  <figure class=" h-62">
    <img src={bgMobile} alt="background-mobile" />
  </figure>

  <div class="absolute z-20 top-0 p-5 md:w-[450px] xl:w-[550px]">
    <h3 class="text-blue-600 font-semibold text-xl xl:text-2xl">
      Our team
    </h3>
    <h1 class="text-[40px] font-medium xl:text-6xl">
      Meet the brain
    </h1>
    <p class="text-charcoal font-medium text-sm xl:text-lg">
      We are proud to have them as part of our community and look forward to
      continuing to push the boundaries of what's possible in the world of
      digital art.
    </p>
  </div>
</section>

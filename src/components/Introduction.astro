---
import bgMobile from "../assets/resources/Background_decor.svg?url";
---

<section class="relative">
  <figure class="abosulte h-62">
    <img src={bgMobile} alt="background-mobile" />
  </figure>

  <div class="absolute z-20 top-0 p-5">
    <h3 class="text-blue-600 font-semibold text-xl">
      Our team
    </h3>
    <h1 class="text-[40px] font-medium">
      Meet the brain
    </h1>
    <p class="text-charcoal font-medium text-sm">
      We are proud to have them as part of our community and look forward to
      continuing to push the boundaries of what's possible in the world of
      digital art.
    </p>
  </div>
</section>
